<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A GUI app on Windows: Exe would leave a console window open for the whole session.
         CLI modes such as self-test and snapshot re-attach to the caller's console in Program.cs. -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <Version>0.1.13</Version>
    <ApplicationIcon>packaging/lyricify-island.ico</ApplicationIcon>
    <!-- Windows needs the WinRT projections for the system media session; other desktop
         platforms keep the plain net10.0 target so the Linux packages build unchanged. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LyricifyIsland</AssemblyName>
    <RootNamespace>LyricifyIsland</RootNamespace>
    <!-- The Wayland accessibility bridge uses Avalonia's internal automation root API. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <!-- Avalonia 12's optional analyzers target newer Roslyn; this app has no XAML generation. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="vendor/**/*.cs" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.FreeDesktop.AtSpi" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="NWayland" Version="0.11.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <ProjectReference Include="vendor/Lyricify-Lyrics-Helper/Lyricify.Lyrics.Helper/Lyricify.Lyrics.Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Headphones/*.json" LogicalName="LyricifyIsland.Headphones.%(Filename)%(Extension)" />
    <EmbeddedResource
      Include="vendor/Lyricify-Lyrics-Helper/Lyricify.Lyrics.Helper/Resources/icon.png"
      LogicalName="LyricifyIsland.icon.png" />
  </ItemGroup>
</Project>
